<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">3110</defaultcontrol>
    <controls>
        <!-- Full-screen backdrop dimmer -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="E6000000">colors/white.png</texture>
        </control>

        <!-- Main Modal Window Frame -->
        <control type="group">
            <centerleft>50%</centerleft><centertop>50%</centertop>
            <width>1800</width><height>950</height>

            <!-- Window Background and Shadow -->
            <control type="image">
                <width>1800</width><height>950</height>
                <texture colordiffuse="FF101216">colors/white.png</texture>
                <bordertexture border="4">overlays/shadow.png</bordertexture>
                <bordersize>4</bordersize>
            </control>

            <!-- Cybernetic Header Banner -->
            <control type="image">
                <width>1800</width><height>70</height>
                <texture colordiffuse="FF181A1F">colors/white.png</texture>
            </control>
            <!-- Glowing Accent Rule Under Header -->
            <control type="image">
                <top>68</top><width>1800</width><height>2</height>
                <texture colordiffuse="$VAR[SkinColorVar]">colors/white.png</texture>
            </control>
            <!-- Dynamic / Default Header Label -->
            <control type="label" id="1">
                <left>30</left><top>0</top><width>1740</width><height>70</height>
                <font>font36_title</font><textcolor>$VAR[SkinColorVar]</textcolor>
                <label>Pick a Color...Any Color</label>
                <align>center</align>
            </control>

            <!-- Left Panel: Swatches Grid -->
            <control type="panel" id="3110">
                <left>20</left><top>95</top>
                <width>1400</width><height>820</height>
                <onright>3012</onright>
                <orientation>vertical</orientation>
                <itemlayout height="70" width="200">
                    <control type="image">
                        <left>5</left><top>5</top><width>190</width><height>60</height>
                        <texture colordiffuse="FF1E2126">colors/white.png</texture>
                    </control>
                    <control type="image">
                        <left>15</left><top>15</top><width>40</width><height>40</height>
                        <texture border="2">$INFO[ListItem.Icon]</texture>
                    </control>
                    <control type="label">
                        <left>65</left><top>5</top><width>125</width><height>60</height>
                        <font>font12</font><textcolor>white</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </itemlayout>
                <focusedlayout height="70" width="200">
                    <control type="image">
                        <left>5</left><top>5</top><width>190</width><height>60</height>
                        <texture colordiffuse="$VAR[SkinColorVar]">colors/white.png</texture>
                    </control>
                    <control type="image">
                        <left>15</left><top>15</top><width>40</width><height>40</height>
                        <texture border="2">$INFO[ListItem.Icon]</texture>
                    </control>
                    <control type="label">
                        <left>65</left><top>5</top><width>125</width><height>60</height>
                        <font>font12</font><textcolor>black</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </focusedlayout>
            </control>

            <!-- Vertical Subtle Divider Line -->
            <control type="image">
                <left>1430</left><top>95</top><width>1</width><height>820</height>
                <texture colordiffuse="1FFFFFFF">colors/white.png</texture>
            </control>

            <!-- Right Column: Swatch Preview, Controls & Skynet Emblem -->
            <control type="group">
                <left>1445</left><top>95</top>
                <!-- Active Color Preview Swatch -->
                <control type="image">
                    <width>330</width><height>130</height>
                    <texture colordiffuse="$INFO[Window.Property(colorstring)]">colors/white.png</texture>
                </control>
                <!-- Frame Around Active Preview Swatch -->
                <control type="image">
                    <width>330</width><height>130</height>
                    <texture border="2">overlays/border.png</texture>
                    <colordiffuse>33FFFFFF</colordiffuse>
                </control>
                <!-- Hex String Display -->
                <control type="label">
                    <top>140</top><width>330</width><height>35</height>
                    <font>font24_title</font><align>center</align>
                    <textcolor>white</textcolor>
                    <label>$INFO[Window.Property(colorstring)]</label>
                </control>
                <!-- Friendly Color Name Display -->
                <control type="label">
                    <top>170</top><width>330</width><height>25</height>
                    <font>font12</font><align>center</align>
                    <textcolor>grey</textcolor>
                    <label>$INFO[Window.Property(colorname)]</label>
                </control>
				
                <!-- Action Buttons Grouplist -->
                <control type="grouplist" id="3000">
                    <top>205</top><width>330</width><itemgap>10</itemgap>
                    <onleft>3110</onleft>
                    <onright>3110</onright>
                    <control type="button" id="3012">
                        <width>330</width><height>54</height>
                        <texturefocus colordiffuse="$VAR[SkinColorVar]">colors/white.png</texturefocus>
                        <texturenofocus colordiffuse="FF22252B">colors/white.png</texturenofocus>
                        <focusedcolor>black</focusedcolor>
                        <textcolor>white</textcolor>
                        <label>Apply and Save</label>
                        <align>center</align>
                        <onleft>3110</onleft>
                        <onup>3011</onup>
                        <ondown>3010</ondown>
                    </control>
                    <control type="button" id="3010">
                        <width>330</width><height>54</height>
                        <texturefocus colordiffuse="$VAR[SkinColorVar]">colors/white.png</texturefocus>
                        <texturenofocus colordiffuse="FF22252B">colors/white.png</texturenofocus>
                        <focusedcolor>black</focusedcolor>
                        <textcolor>white</textcolor>
                        <label>Enter Kodi Color Code</label>
                        <align>center</align>
                        <onleft>3110</onleft>
                        <onup>3012</onup>
                        <ondown>3015</ondown>
                    </control>
                    <control type="label">
                        <width>330</width><height>22</height>
                        <font>font12</font><textcolor>grey</textcolor>
                        <label>Change Opacity</label><align>center</align>
                    </control>
                    <control type="slider" id="3015">
                        <width>330</width><height>36</height>
                        <texturesliderbar colordiffuse="FF22252B">colors/white.png</texturesliderbar>
                        <textureslidernib colordiffuse="$VAR[SkinColorVar]">colors/white.png</textureslidernib>
                        <onleft>3110</onleft>
                        <onup>3010</onup>
                        <ondown>3011</ondown>
                    </control>
                    <control type="button" id="3011">
                        <width>330</width><height>54</height>
                        <texturefocus colordiffuse="$VAR[SkinColorVar]">colors/white.png</texturefocus>
                        <texturenofocus colordiffuse="FF22252B">colors/white.png</texturenofocus>
                        <focusedcolor>black</focusedcolor>
                        <textcolor>white</textcolor>
                        <label>Reset to Default</label>
                        <align>center</align>
                        <onleft>3110</onleft>
                        <onup>3015</onup>
                        <ondown>3012</ondown>
                    </control>
                </control>

                <!-- Skynet Cybernetic Branding Emblem (Color Adaptable) -->
                <control type="image">
                    <top>485</top>
                    <left>0</left>
                    <width>330</width>
                    <height>335</height>
                    <aspectratio align="center" aligny="center">keep</aspectratio>
                    <texture>special://skin/extras/original-skynet-logo.png</texture>
                    <colordiffuse>$VAR[SkinColorVar]</colordiffuse>
                </control>
            </control>
        </control>
    </controls>
</window>
