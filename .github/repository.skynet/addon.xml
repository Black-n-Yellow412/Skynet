<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.skynet" name="Skynet Repository" version="1.0.1" provider-name="Black-n-Yellow412">
    <requires>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="Skynet Repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/Black-n-Yellow412/Skynet/gh-pages/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/Black-n-Yellow412/Skynet/gh-pages/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/Black-n-Yellow412/Skynet/gh-pages/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Skynet Kodi Skin Repository</summary>
        <description lang="en_GB">The official repository for the Skynet skin for Kodi 22 (Piers).</description>
        <disclaimer lang="en_GB">Install this repository to receive automatic updates for the Skynet skin.</disclaimer>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
